# Copy to .env.local and fill in. All are optional for local dev.

# Public site URL (used by sitemap, robots, QR, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://jbflow.my

# Supabase (Phase 2, when DB is live). Leave blank to use src/lib/data.ts.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Analytics (Phase 4).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=jbflow.my

# Link-health monitor alert webhook (optional).
# ALERT_WEBHOOK=
